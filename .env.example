# PostgreSQL (async driver asyncpg — dùng scheme postgresql+asyncpg)
# Bắt buộc trỏ tới DB bạn dùng (local hoặc remote). Docker Compose API: chỉ cần URL remote + Redis trong compose.
#
# Remote (ví dụ):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@REMOTE_HOST:5432/DBNAME
#
# Local (khi không dùng Docker cho API):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qcmaster
#
# Nếu DB yêu cầu TLS/SSL, có thể cần thêm tham số (tùy provider):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@REMOTE_HOST:5432/DBNAME?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qcmaster
# Bật log SQL (dev)
DB_ECHO=false

# Auth — bắt buộc production (HS256)
SECRET_KEY=change-me-to-a-long-random-string-in-production

# Redis (rate limit login, refresh token revoke). Khi chạy API bằng docker compose, compose ghi đè REDIS_URL → redis trong network.
REDIS_URL=redis://localhost:6379/0

# JWT / cookie
ACCESS_TOKEN_EXPIRE_SECONDS=900
REFRESH_TOKEN_EXPIRE_SECONDS=604800
# CORS origins FE (ví dụ Next.js) — phân tách bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Dev: false để cookie Secure không bắt buộc HTTPS local
COOKIE_SECURE=false
# strict | lax | none (tài liệu: Strict; cross-origin dev có thể cần lax)
COOKIE_SAMESITE=lax

# Cloudflare R2 (download presigned + optional public CDN)
# Presigned: cần endpoint + key + secret + bucket; cài thêm: pip install boto3
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# URL công khai (vd. custom domain CDN) — dùng khi không presign hoặc làm fallback
# R2_PUBLIC_BASE_URL=https://cdn.example.com

# Anthropic API — dùng cho LLM chunker (Claude Haiku semantic chunking).
# Nếu không set hoặc để trống → tự động fallback sang rule-based chunker.
# ANTHROPIC_API_KEY=sk-ant-...
#
# Third-party Claude-compatible API (OpenRouter, Together AI, v.v.)
# Nếu dùng provider khác Anthropic, set cả 2 biến dưới:
# ANTHROPIC_API_KEY=<key-của-provider>
# ANTHROPIC_BASE_URL=https://openrouter.ai/api/v1
# ANTHROPIC_BASE_URL=

# Embedding service (FastAPI riêng) — qcmaster-api sẽ proxy qua HTTP khi set URL
# Ví dụ khi chạy embedding-service Docker map host port 8108 -> container 8001:
# EMBEDDING_SERVICE_URL=http://127.0.0.1:8108
#
# Nếu qcmaster-api chạy trong Docker Compose còn embedding-service chạy trên host:
# macOS/Windows Docker Desktop:
# EMBEDDING_SERVICE_URL=http://host.docker.internal:8108
#
# Internal key phải khớp env `EMBEDDING_SERVICE_INTERNAL_KEY` của embedding-service
# EMBEDDING_SERVICE_INTERNAL_KEY=change-me
#
# Lưu ý pipeline upload hiện tại:
# - Tự tải object từ R2, chunk text, gọi embedding-service, lưu `chunks` + `chunk_embeddings` (pgvector)
# - Pipeline chỉ extract file Markdown: `.md` (định dạng khác sẽ fail và version có thể bị `rejected`)
